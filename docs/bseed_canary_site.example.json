{
  "mqtt_config": "/private/zigbee2mqtt/configuration.yaml",
  "broker": "BROKER_LAN_ADDRESS",
  "serve_root": "/private/ota/serve",
  "publish": {
    "ssh_alias": "ha",
    "remote_dir": "/config/www/bseed-canary",
    "url_base": "http://HA_LAN_ADDRESS:8123/local/bseed-canary"
  },
  "campaign_root": "/private/ota/campaigns",
  "lock_search_roots": ["/private/ota/older-campaign-workdirs"],
  "ha_ssh_alias": "ha",
  "z2m_database": "/config/zigbee2mqtt/database.db",
  "network_lock_dir": "/private/shared-ota-authority",
  "network_id": "VERIFIED_COORDINATOR_IEEE",
  "pm_ssh_host": "PRIVATE_Z2M_HOST",
  "pm_ssh_key": "/private/keys/host_verified_ssh_identity",
  "devices": {
    "PM_CLIENT_FRIENDLY_NAME": {
      "ieee": "0x0011223344556677",
      "board": "pm",
      "role": "EndDevice",
      "expect_relay": "OFF"
    },
    "PM_ROUTER_FRIENDLY_NAME": {
      "ieee": "0x0011223344556678",
      "board": "pm",
      "role": "Router",
      "expect_relay": "ON",
      "pm_settings_baseline": "/private/ota/baselines/pm_router_settings.json"
    },
    "NONPM_SOCKET_FRIENDLY_NAME": {
      "ieee": "0x0011223344556679",
      "board": "nonpm",
      "role": "EndDevice",
      "expect_relay": "OFF",
      "relay_physical_mode": "attached",
      "recovery_evidence": "/private/ota/recovery/nonpm_socket.json",
      "overrides": {"block_bytes": 48}
    }
  }
}
